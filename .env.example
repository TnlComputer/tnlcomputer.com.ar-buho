# Plantilla para PRODUCCIÓN (hosting). Copiar como .env y completar lo marcado con <...>.
APP_NAME="TNL Computer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.tnlcomputer.com.ar
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base MySQL de DirectAdmin. Puede ser la misma del sitio viejo (las tablas nuevas no pisan
# productos/rubros/ofertas) o una nueva.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tnlcom55_tienda
DB_USERNAME=tnlcom55_<usuario de la base>
DB_PASSWORD=<contraseña>


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Casilla creada en DirectAdmin (E-mail Manager). Puerto 465 = ssl, 587 = tls.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.tnlcomputer.com.ar
MAIL_PORT=465
MAIL_USERNAME=no-reply@tnlcomputer.com.ar
MAIL_PASSWORD=<contraseña de la casilla>
MAIL_FROM_ADDRESS="no-reply@tnlcomputer.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

# Mercado Pago (mercadopago.com.ar/developers → Tus integraciones → tu aplicación)
# Access Token de PRODUCCIÓN (empieza con APP_USR-). Para probar, usar el de prueba (TEST-).
MP_ACCESS_TOKEN=
# Webhooks → URL https://www.tnlcomputer.com.ar/webhooks/mercadopago, evento "Pagos" → copiar la "clave secreta".
# Obligatoria en producción: sin ella se rechazan todos los avisos.
MP_WEBHOOK_SECRET=
MP_MAX_INSTALLMENTS=12
# Medios excluidos: ticket = efectivo (Rapipago/Pago Fácil), atm = cajero. Vacío = ofrecer todos.
MP_EXCLUDED_PAYMENT_TYPES=ticket,atm
MP_STATEMENT_DESCRIPTOR=TNLCOMPUTER

# Datos del sitio (opcionales; los valores por defecto están en config/tnl.php)
TNL_MAIL_INFO=info@tnlcomputer.com.ar
TNL_MAIL_SERVICE=service@tnlcomputer.com.ar
TNL_MAIL_PEDIDOS=info@tnlcomputer.com.ar
# TNL_EMAIL=info@tnlcomputer.com.ar
# TNL_WHATSAPP=5491149156462
# Link de cobro fijo del negocio en Mercado Pago (Link de pago → "Creá un link que identifique tu negocio").
# Se ofrece en los pedidos sin link propio mientras el pago automático no esté disponible.
# TNL_PAYMENT_LINK=https://link.mercadopago.com.ar/...

VITE_APP_NAME="${APP_NAME}"

# Recargo % sobre la lista del proveedor al importar
TNL_MARKUP=20

# ── Publicación automática en redes (php artisan tnl:redes) ──────────────────────────────────────────────
# Sale un producto al azar (foto, precio y link) en cada horario. Una red sin sus datos no se usa.
# Requiere el cron de DirectAdmin (Advanced Features → Cron Jobs), todos los campos en * (cada minuto):
#   /usr/local/bin/php /home/tnlcom55/domains/tnlcomputer.com.ar/public_html/artisan schedule:run >> /dev/null 2>&1
SOCIAL_TIMES=10:00,13:00,18:00,21:00
SOCIAL_REPEAT_DAYS=60

# Facebook (Meta):
#  1. developers.facebook.com → Mis apps → Crear app → tipo "Empresa" (Business).
#  2. developers.facebook.com/tools/explorer → elegir la app → "Generar token de acceso" con los permisos
#     pages_show_list, pages_read_engagement, pages_manage_posts.
#  3. developers.facebook.com/tools/debug/accesstoken → pegar ese token → "Ampliar token de acceso" (dura 60 días).
#  4. De vuelta en el Explorer, con el token ampliado, consultar:  me/accounts
#     → de la página TNL Computer copiar "id" a FACEBOOK_PAGE_ID y "access_token" a FACEBOOK_PAGE_TOKEN
#       (el token de página que sale de un token ampliado no vence).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# Instagram (cuenta profesional; no hace falta vincularla a la página de Facebook):
#  1. En la misma app de Meta → Casos de uso → Instagram → "API con inicio de sesión de Instagram"
#     (permisos instagram_business_basic e instagram_business_content_publish).
#  2. Roles de la app → agregar la cuenta de Instagram como "Evaluador de Instagram" y aceptar la invitación
#     (Instagram → Configuración → Apps y sitios web → Invitaciones de evaluador).
#  3. En el caso de uso → "Generar tokens de acceso" → agregar la cuenta → generar el token (dura 60 días;
#     el sitio lo renueva solo cada semana mientras se use) y pegarlo acá.
INSTAGRAM_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0

# Threads (casos de uso de la misma app de Meta → "Acceder a la API de Threads"):
#  1. En la app → Casos de uso → Threads → Personalizar: agregar los permisos threads_basic y threads_content_publish.
#  2. Roles de la app → agregar la cuenta de Threads de la empresa como "Probador de Threads" y aceptar la invitación
#     en Threads (Configuración → Cuenta → Permisos de sitios web).
#  3. Casos de uso → Threads → "Generador de tokens de acceso de usuario" → generar el token de la cuenta (dura 60 días;
#     el sitio lo renueva solo cada semana mientras se use) y pegarlo acá.
THREADS_ACCESS_TOKEN=

# X (Twitter):
#  1. developer.x.com → entrar con la cuenta @tnlcomputer → registrarse en el plan Free.
#  2. En la app → "User authentication settings" → Permisos: "Read and write"; Tipo: "Web App, Automated App or Bot";
#     Callback URL y Website: https://www.tnlcomputer.com.ar
#  3. "Keys and tokens": API Key y API Key Secret → X_API_KEY / X_API_SECRET.
#     Access Token y Secret (generarlos DESPUÉS del paso 2, si no quedan de solo lectura) → X_ACCESS_TOKEN / X_ACCESS_TOKEN_SECRET.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# TikTok (publica la imagen como post de foto):
#  1. developers.tiktok.com → entrar con la cuenta de TikTok de la empresa → Manage apps → Connect an app.
#  2. Agregar los productos "Login Kit" y "Content Posting API" (activar "Direct Post"); scopes user.info.basic y video.publish.
#     Redirect URI (Login Kit): https://www.tnlcomputer.com.ar/
#  3. En "URL properties" verificar el prefijo https://www.tnlcomputer.com.ar/uploads/social/ (TikTok baja las fotos de ahí).
#  4. Copiar Client key y Client secret acá. Después, en la PC (con esas dos líneas en el .env local):
#     php artisan tnl:tiktok-conectar  → autorizar → pegar acá el TIKTOK_REFRESH_TOKEN que muestra (dura 1 año).
#  5. Mandar la app a revisión ("Submit for review"). Mientras no esté aprobada, TikTok solo deja publicar en
#     privado: dejar TIKTOK_PRIVACY=SELF_ONLY hasta la aprobación y después borrar esa línea.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# Instalador web de un solo uso: poné una clave larga, entrá a https://www.tnlcomputer.com.ar/instalar
# y después borrá esta línea.
INSTALL_TOKEN=

# Content-Security-Policy: report = solo registra en el log lo que bloquearía; enforce = bloquea; off = sin CSP.
TNL_CSP=report
